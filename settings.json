{
  "env": {
    "SLASH_COMMAND_TOOL_CHAR_BUDGET": "15000",
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "defaultMode": "auto"
  },
  "skillOverrides": {
    "asana-comments": "user-invocable-only"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre_tool_use.py",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /Users/jacobtellep/.claude/hooks/rm_rf_guard.py --platform claude",
            "timeout": 5,
            "statusMessage": "Checking recursive deletion approval"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/jacobtellep/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "figma@claude-plugins-official": true,
    "chrome-devtools-mcp@chrome-devtools-plugins": true,
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "chrome-devtools-plugins": {
      "source": {
        "source": "github",
        "repo": "ChromeDevTools/chrome-devtools-mcp"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Forging in Mount Doom",
      "Journeying to Mordor",
      "Summoning the Ents",
      "Crossing the Mines of Moria",
      "Seeking counsel in Rivendell",
      "Lighting the beacons of Gondor",
      "Riding to Helm's Deep",
      "Gathering the Fellowship",
      "Whispering to the Ring",
      "Unraveling Saruman's schemes",
      "Traversing the Paths of the Dead",
      "Searching the archives of Minas Tirith",
      "Gazing into Galadriel's mirror",
      "Sharpening Anduril",
      "Resting at a bonfire",
      "Praising the sun",
      "Kindling the First Flame",
      "Rolling through fog gates",
      "Reading a soapstone message",
      "Retrieving lost souls",
      "Reversing hollowing",
      "Parrying the Black Knight",
      "Linking the fire",
      "Feeding the Lordvessel",
      "Traversing the Abyss",
      "Dying and trying again",
      "Offering humanity",
      "Gaining insight",
      "Ringing the sinister bell",
      "Entering the Nightmare",
      "Communing with the Great Ones",
      "Performing a visceral attack",
      "Rallying through the pain",
      "Seeking eyes on the inside",
      "Opening the gate to Byrgenwerth",
      "Ascending to the Nightmare of Mensis",
      "Using the Force",
      "Making the Kessel Run",
      "Consulting the Jedi archives",
      "Feeling a disturbance in the Force",
      "Powering up the hyperdrive",
      "Training on Dagobah",
      "Negotiating with Jawas",
      "Deflecting blaster bolts",
      "Meditating in the Jedi Temple",
      "Assembling a lightsaber",
      "Reaching out with feelings",
      "Executing Order 66",
      "Summoning Torrent",
      "Wandering the Lands Between",
      "Seeking the Great Runes",
      "Consulting the Two Fingers",
      "Mending the Elden Ring",
      "Collecting Korok seeds",
      "Playing the Song of Time",
      "Smokes, let's go",
      "Getting two birds stoned at once",
      "Worst case Ontario",
      "Checking the rocket appliances",
      "Practicing survival of the fitness",
      "Rounding up shopping carts",
      "Dodging Mr. Lahey",
      "Watching for shit winds",
      "Hunting the samsquanch"
    ]
  },
  "effortLevel": "medium",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "editorMode": "normal",
  "verbose": true,
  "switchModelsOnFlag": false,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
